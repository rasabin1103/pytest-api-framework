# ==========================================================================
# Configuracion base de la API bajo prueba
# ==========================================================================
# BASE_URL debe contener SOLO la base comun (sin el endpoint).
# Correcto:   BASE_URL=https://mi-api.com/api
# Incorrecto: BASE_URL=https://mi-api.com/api/fruit/all
BASE_URL=https://fruityvice.com/api
TIMEOUT=10
VERIFY_SSL=true

# Endpoint usado por el test de ejemplo (tests/health/test_fruits.py).
# Cualquier otro endpoint se pasa por parametro: client.get("/mi/endpoint")
HEALTH_ENDPOINT=/fruit/all

# ==========================================================================
# Logging - "maxima informacion"
# ==========================================================================
LOG_HTTP=true
LOG_LEVEL=DEBUG
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
LOG_BODY_MAX_CHARS=2000

# ==========================================================================
# Autenticacion / headers especiales
# ==========================================================================
# AUTH_TYPE: none | bearer | basic | api_key | custom
AUTH_TYPE=none

# --- bearer ---
AUTH_TOKEN=

# --- basic ---
AUTH_USERNAME=
AUTH_PASSWORD=

# --- api_key ---
API_KEY_HEADER=x-api-key
API_KEY_VALUE=

# Headers estaticos adicionales, para CUALQUIER auth_type (JSON valido).
# Ej: EXTRA_HEADERS={"X-Client-Id":"qa-suite","Accept-Language":"es"}
EXTRA_HEADERS={}
